  "capabilities": {
    "text": true,
    "streaming": true,
    "tools": "model-dependent",
    "toolsWithStreaming": false,
    "structuredOutput": false,
    "structuredOutputWithTools": false,
    "embeddings": false,
    "thinking": false
  },
  "errorRules": [
    {
      "pattern": "API_TOKEN_INVALID|Invalid token",
      "class": "authentication",
      "message": "Invalid HuggingFace API token. Please check your {apiKeyEnvVar} environment variable."
    },
    {
      "pattern": "rate limit",
      "class": "rate-limit",
      "message": "HuggingFace rate limit exceeded. Consider using a paid plan or try again later."
    },
    {
      "pattern": "model.*not found|not found.*model",
      "class": "invalid-model",
      "message": "HuggingFace model '{model}' not found.\n\nSuggestions:\n1. Check model name spelling\n2. Ensure model exists on HuggingFace Hub\n3. For tool calling, use: Llama-3.1-8B-Instruct, Hermes-3-Llama-3.2-3B, or CodeLlama-34b-Instruct-hf"
    },
    {
      "pattern": "function|tool",
      "class": "provider",
      "message": "HuggingFace tool calling error: {message}\n\nNotes:\n1. Ensure you're using a tool-capable model (Llama-3.1+, Hermes-3+, CodeLlama)\n2. Check that your model supports function calling\n3. Verify tool schema format is correct"
    }
  ],
  "timeouts": {
    "generateMs": 120000,
    "streamMs": 120000
  },
  "autoSelectPriority": 10,
  "setup": {
    "url": "https://huggingface.co/settings/tokens",
    "apiKeyFormat": "^hf_[A-Za-z0-9]{37}$",
    "billingPolicy": "free-with-card",
    "instructions": [
      "1. Visit: https://huggingface.co/settings/tokens",
      "2. Create or sign in to your HuggingFace account",
      "3. Generate a new access token",
      "4. Set {apiKeyEnvVar} in your .env file (HF_TOKEN also accepted)"
    ]
  },
  "evidence": {
    "rosterVerified": {
      "date": "2026-09-22",
      "method": "Ported from already-committed repo data (HuggingFaceModels enum, huggingfaceManifest.ts, the hand ProviderDescriptor, and huggingFace/client.ts's own error-rule/model comments) on this worktree's current state — no live vendor probe performed, per this migration's no-vendor-call constraint. models.catalog carries every member of the HuggingFaceModels enum it replaces, with the same enumMember names, plus the Llama-3.1-8B-Instruct fallback; topModels restores the previous picker order and text. Per-model vision is false to mirror huggingfaceManifest, which declares no HuggingFace vision support — it is not a vendor capability claim; billingPolicy is carried over from general knowledge, not independently re-verified live. testModel and the capability flags mirror the hand-written live-matrix row this entry replaces (test/helpers/providerMatrix.ts on origin/release), so the migration leaves the set of live-matrix cells unchanged."
    },
    "liveMatrix": null,
    "addedInPR": "TBD — integration-tested in a worktree before a PR was opened"
  }
