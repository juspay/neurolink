# would be sent to Perplexity as a real key, and with it built-in features
# would start sending their decision requests there.
# PERPLEXITY_API_KEY=your-perplexity-api-key
# Optional: PERPLEXITY_MODEL=sonar
# Optional: PERPLEXITY_BASE_URL=https://api.perplexity.ai

