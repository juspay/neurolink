# ElevenLabs — one key serves TTS, Scribe STT (elevenlabs-stt) and music
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# API base URL including /v1, shared by TTS, STT and music (proxy or test stub)
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
# TTS defaults (a per-request voice / model wins): Rachel, eleven_multilingual_v2
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL=eleven_v3

# OpenAI TTS (uses OPENAI_API_KEY above — model: gpt-4o-mini-tts)
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# =============================================================================
# SPEECH-TO-TEXT (STT)
# =============================================================================

# Default provider for transcribe(), transcribeStream() and generate({ stt })
# without an explicit one. Unset: the first configured provider in this order —
# whisper (OPENAI_STT_API_KEY / OPENAI_API_KEY), deepgram, elevenlabs-stt,
# google-stt, azure-stt — and, when NOTHING is set, the built-in local engine
# "whistle" (alias "local"), which runs on this machine and needs no key.
# NEUROLINK_STT_PROVIDER=whisper
# Model for the default provider (ignored when a call names its provider).
# NEUROLINK_STT_MODEL=whisper-1
# Language when a call names none. Unset or "auto" lets the engine detect it.
# NEUROLINK_STT_LANGUAGE=auto
# Correction layer defaults (transcribe --correct / correction: {...}): the text
# provider and model used for the rewrite when a request names none. Any text
# provider works; a fast model matters more than a big one.
# NEUROLINK_STT_REWRITE_PROVIDER=litellm
# NEUROLINK_STT_REWRITE_MODEL=<fast-chat-model>
# Named OpenAI-compatible endpoints, each a provider of its own (JSON object):
# NEUROLINK_STT_ENDPOINTS='{"indic":{"baseURL":"http://127.0.0.1:8007/v1","model":"indic-conformer"},"spark":{"baseURL":"http://gpu-box:4000/v1","apiKey":"sk-...","model":"qwen3-asr"}}'
# `neurolink serve` request timeout in ms (default 30000); raise it when transcribing long
# recordings through a remote engine. A serve config file's `timeout` wins over this.
# NEUROLINK_SERVER_TIMEOUT_MS=300000

# Deepgram STT (provider "deepgram"; native streaming).
# DEEPGRAM_API_KEY=your-deepgram-api-key
# Self-hosted or regional Deepgram endpoint; streaming uses the same host over wss.
# DEEPGRAM_BASE_URL=https://api.deepgram.com/v1

# ElevenLabs Scribe STT (provider "elevenlabs-stt", alias "scribe") — uses
# ELEVENLABS_API_KEY above. Diarizes (speaker labels), detects language,
# handles code-switched speech such as Hinglish. Model: scribe_v2.
# Base URL for STT only (including /v1); falls back to ELEVENLABS_BASE_URL.
# ELEVENLABS_STT_BASE_URL=https://api.elevenlabs.io/v1

# OpenAI-compatible STT endpoint (provider "whisper"). Leave unset for OpenAI.
# Point it at a self-hosted server — vLLM serving an ASR model, LiteLLM, or the
# NeuroLink diarization sidecar — and pass `model` (e.g. "qwen3-asr") per call.
# The dedicated key means a keyless local server never borrows OPENAI_API_KEY.
# OPENAI_STT_BASE_URL=http://localhost:8000/v1
# OPENAI_STT_API_KEY=dummy
# A whole meeting takes minutes on a local server; the default is 30000 (30 s).
# OPENAI_STT_TIMEOUT_MS=600000

# Azure Cognitive Services TTS
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=eastus

# Fish Audio TTS (S2 Pro — 80% cheaper than ElevenLabs, 15s voice cloning)
FISH_AUDIO_API_KEY=your-fish-audio-api-key
# FISH_AUDIO_VOICE_ID=your-fish-audio-voice-id

# 60db TTS — workspace API key; voice UUID can also be supplied per request.
# Output is WAV (default) or PCM16 only.
SIXTYDB_API_KEY=
# SIXTYDB_DEFAULT_VOICE=
# Endpoint override; HTTPS unless loopback
# SIXTYDB_BASE_URL=https://api.60db.ai

