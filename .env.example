SAMBANOVA_API_KEY=your-sambanova-api-key
# Optional: SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
# Optional: SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1

